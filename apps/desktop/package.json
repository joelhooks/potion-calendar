{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Potion Calendar desktop shell",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "pnpm --filter @calendar/core build && tsc --noEmit -p tsconfig.build.json && node --experimental-strip-types scripts/build.ts",
    "check": "pnpm run typecheck",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dev": "pnpm build && electron .",
    "e2e": "pnpm build && node --experimental-strip-types e2e/desktop.ts",
    "package:mac": "pnpm build && node --experimental-strip-types scripts/package-mac.ts"
  },
  "dependencies": {
    "@calendar/capability": "workspace:*",
    "@calendar/core": "workspace:*",
    "@xstate/effect": "1.0.0-alpha.8",
    "effect": "4.0.0",
    "xstate": "6.0.0-alpha.69"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0",
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "@types/node": "24.13.6",
    "electron": "44.9.0",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.0.7",
    "vitest": "5.0.3"
  },
  "productName": "Potion Calendar"
}
