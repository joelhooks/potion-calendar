{
  "name": "@calendar/auth",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./service": {
      "types": "./src/auth-service.ts",
      "import": "./dist/auth-service.js",
      "default": "./dist/auth-service.js"
    },
    "./devtools": {
      "types": "./src/devtools.ts",
      "import": "./dist/devtools.js",
      "default": "./dist/devtools.js"
    },
    "./google": {
      "types": "./src/google.ts",
      "import": "./dist/google.js",
      "default": "./dist/google.js"
    },
    "./google-tokens": {
      "types": "./src/google-tokens.ts",
      "import": "./dist/google-tokens.js",
      "default": "./dist/google-tokens.js"
    },
    "./dev/fake-google": {
      "types": "./src/dev/fake-google.ts",
      "import": "./dist/dev/fake-google.js",
      "default": "./dist/dev/fake-google.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm run typecheck",
    "pretest": "pnpm run --silent build"
  },
  "dependencies": {
    "@alchemy.run/better-auth": "2.0.0-beta.83",
    "@calendar/capability": "workspace:*",
    "@calendar/database": "workspace:*",
    "@xstate/effect": "1.0.0-alpha.8",
    "alchemy": "2.0.0-beta.83",
    "better-auth": "1.6.2",
    "effect": "4.0.0",
    "xstate": "6.0.0-alpha.69"
  },
  "devDependencies": {
    "@calendar/devtools": "workspace:*",
    "@cloudflare/workers-types": "5.20260901.1",
    "@effect/vitest": "4.0.0",
    "@types/node": "24.13.6",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
