# @currentEnv=$APP_ENV
# @defaultRequired=false
# @defaultSensitive=true
# ---

# @type=enum(development, test, production)
# @sensitive=false
APP_ENV=development

# @required=forEnv(production)
# @type=string
# @sensitive=false
ALCHEMY_PROFILE=

# @required=forEnv(production)
# @type=string
# @sensitive=false
GOOGLE_CLIENT_ID=

# @required=forEnv(production)
# @type=string
# @sensitive=true
GOOGLE_CLIENT_SECRET=

# @required=forEnv(production)
# @type=string
# @sensitive=true
BETTER_AUTH_SECRET=

# Comma-separated Google account emails. Values are supplied by the desk.
# @required=forEnv(production)
# @type=string
# @sensitive=true
ALLOWED_EMAILS=

# @type=url
# @sensitive=false
PORTLESS_URL=

# @type=string
# @sensitive=false
TURBO_HASH=

# @type=number
# @sensitive=false
DEPLOY_CONTENT_VERSION_DEADLINE_MS=120000

# @type=number
# @sensitive=false
DEPLOY_WORKER_VERSION_DEADLINE_MS=120000

# UTC quiet windows as JSON. No automatic rollback runs.
# @type=string
# @sensitive=false
DEPLOY_QUIET_WINDOWS=

# @type=number
# @sensitive=false
DEPLOY_QUIET_WINDOW_MAX_WAIT_MS=0
